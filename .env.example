# Google Gemini API key — required
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB — required for auth, user management, and review history
# Supports MongoDB Atlas (free tier) or any MongoDB instance
# 1. Create a cluster at https://cloud.mongodb.com (free tier available)
# 2. Add your IP to the allow-list (or 0.0.0.0/0 for Vercel)
# 3. Copy the connection string (include database name in the URI)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/qti-reviewer?retryWrites=true&w=majority

# JWT secret — required for signing session tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Default admin credentials — used to seed the first admin account
# on the very first boot (when the users collection is empty).
# Change the password via the Admin panel after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Default Gemini model (fallback if DB settings not yet configured)
DEFAULT_MODEL=gemini-2.5-flash
